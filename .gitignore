###############################################
#  TraceOff Project .gitignore
#  Optimized for Python, build tools, PySide6 GUI,
#  logs, virtual envs, and local machine artifacts.
###############################################

# -----------------------------
# 🚀 Python cache & compiled files
# -----------------------------
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# -----------------------------
# 📦 Distribution & packaging
# -----------------------------
build/
dist/
downloads/
.eggs/
*.egg-info/
sdist/
wheels/
*.egg
*.whl
MANIFEST

share/python-wheels/
pip-wheel-metadata/

# -----------------------------
# 🧪 Testing / Coverage
# -----------------------------
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
pytest_cache/
.pytest_cache/
coverage.xml
nosetests.xml
*.cover

# Hypothesis test cache
.hypothesis/

# -----------------------------
# ⚙ PyInstaller
# -----------------------------
*.spec
*.manifest

# -----------------------------
# 📁 Virtual environments
# -----------------------------
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
pyvenv.cfg
pip-selfcheck.json

# Classic patterns
.Python
[Bb]in/
[Ll]ib/
[Ll]ib64/
[Ll]ocal/
[Ii]nclude/
[Ss]cripts/

# -----------------------------
# 🧪 Python Packaging Tools (Optional)
# -----------------------------
# pipenv
#Pipfile.lock

# poetry
#poetry.lock

# pdm
.pdm.toml
#pdm.lock

# __pypackages__ (PEP 582)
__pypackages__/

# -----------------------------
# 📝 Logs & runtime files
# -----------------------------
*.log
*.tmp
*.bak
*.old
*.trace
traceoff.log

# -----------------------------
# 🔒 Local Config/Data (not published)
# -----------------------------
# User-level configs (safe for user but not in repo)
config.json
*.secrets.json
token.json

# System-specific cache
system_state.json

# -----------------------------
# 🖥 GUI / PySide6 cache
# -----------------------------
__pyside6_cache__/
*.qmlc
*.jsc

# -----------------------------
# 🧵 IDE / Editor files
# -----------------------------
.idea/
.vscode/
*.sublime-workspace
*.sublime-project
*.swp
*.DS_Store

# -----------------------------
# 📚 Documentation builds
# -----------------------------
# mkdocs
/site/

# Sphinx
docs/_build/

# Jupyter notebooks
.ipynb_checkpoints/

# -----------------------------
# 🧠 Type checkers & tooling
# -----------------------------
.mypy_cache/
.dmypy.json
dmypy.json
.pytype/
.pyre/

# -----------------------------
# 🔧 CI Artifacts
# -----------------------------
*.coverage-report
test-output/
coverage-html/

# -----------------------------
# 🔌 Plugins (local development)
# -----------------------------
# Ignore local plugins unless they are intentionally added
~/.config/traceoff/plugins/

###############################################
# End of .gitignore
###############################################
